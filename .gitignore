# Binary Go
*.exe
*.exe~
penanda
penanda.exe

# Runtime Data (Data lokal & backup harian pengguna)
# Mencegah data riil link/dokumen pengguna ter-commit ke repo
data.json
data-*.json
*.tmp
*.log

# Pastikan data contoh tetap di-track oleh git
!src/shared/data.example.json

# Build & Distribusi Paket
dist/
build/

# Paket rilis V1 ikut di-track supaya bisa diunduh langsung dari GitHub.
# penanda.exe tetap diabaikan: 9,7 MB artefak build, dibangun sendiri
# dengan `go build -o dist/v1/penanda.exe ./src/pro`.
!dist/
!dist/*.txt
!dist/v1/
!dist/v1/*.html
!dist/v1/*.js
!dist/v1/*.css
!dist/v1/*.txt
!dist/v1/data.example.json

